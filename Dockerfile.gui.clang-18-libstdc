# syntax=docker/dockerfile:1.7
#
# GUI CI image for C++23 with clang-18 (libstdc++)
# Inherits from: ghcr.io/ai-warevo/ci-cpp23:clang-18-libstdc
#
# Adds: X11/OpenGL dev packages, Xvfb for headless GUI testing
# GLFW 3.4 and Dear ImGui already in parent image at /opt/deps/clang-18-libstdc/
#
# Pushed to ghcr.io/ai-warevo/ci-cpp23-gui:clang-18-libstdc

ARG BASE_IMAGE=ghcr.io/ai-warevo/ci-cpp23:clang-18-libstdc
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# Install X11/OpenGL/Mesa dev packages + Xvfb
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libx11-dev \
        libxrandr-dev \
        libxinerama-dev \
        libxcursor-dev \
        libxi-dev \
        libgl1-mesa-dev \
        libglu1-mesa-dev \
        mesa-common-dev \
        libgl1-mesa-dri \
        libglx-mesa0 \
        mesa-utils \
        xvfb \
        x11-utils && \
    rm -rf /var/lib/apt/lists/*

# Set display for Xvfb headless testing
ENV DISPLAY=:99
